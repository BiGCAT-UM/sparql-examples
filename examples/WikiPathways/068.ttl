@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:068 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Pathway Count per Curation Tag"@en ;
    rdfs:comment "Counts the pathways per curation and community tag."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?curationTag (count(DISTINCT ?pathway) as ?pathwayCount)
WHERE {
  ?pathway wp:ontologyTag ?curationTag .
  FILTER contains(STR(?curationTag), "Curation:")
}
GROUP BY ?curationTag
ORDER BY DESC(?pathwayCount)""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "community", "counts", "curation", "communities" ;
    prov:wasDerivedFrom <https://www.wikipathways.org/sparql.html> ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:created "2024-10-20"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ068> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/B.%20Communities/PathwayCountPerCurationTag.ttl> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
