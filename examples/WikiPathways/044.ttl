@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:044 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "References for a Specific Interaction"@en ;
    rdfs:comment "Returns publication references for a single interaction identified by both a pathway and a specific participant URI. This example uses the default values (Pathway ID \"WP5200\", UniProt Protein ID \"P35498\"); open it in the WikiPathways SPARQL editor to change them: https://sparql.wikipathways.org/?example=WPQ044"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway ?interaction ?pubmed WHERE {
   ?pathway a wp:Pathway .
   VALUES ?pathwayId { <https://identifiers.org/wikipathways/WP5200> }
   ?pathway dc:identifier ?pathwayId . #filter for pathway
   ?interaction dcterms:isPartOf ?pathway .
   ?interaction a wp:Interaction .
   VALUES ?proteinId { <https://identifiers.org/uniprot/P35498> }
   ?interaction wp:participants ?proteinId. #filter for interaction
  ?interaction dcterms:references ?pubmed .
} LIMIT 100""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "literature" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/4431b11d148e0e1bcc3533e90b80225376c80d1a/E.%20Literature/referencesForSpecificInteraction.rq> ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2022-10-26"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ044> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/E.%20Literature/referencesForSpecificInteraction.ttl> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
