@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:044 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "References for a Specific Interaction"@en ;
    rdfs:comment "Returns publication references for a single interaction identified by both a pathway and a specific participant URI. This example uses the default values (Pathway ID \"WP5200\", UniProt Protein ID \"P35498\"); the WikiPathways SNORQL UI lets you change them."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway ?interaction ?pubmed WHERE {
   ?pathway a wp:Pathway .
   ?pathway dc:identifier <https://identifiers.org/wikipathways/WP5200> . #filter for pathway
   ?interaction dcterms:isPartOf ?pathway .
   ?interaction a wp:Interaction .
   ?interaction wp:participants <https://identifiers.org/uniprot/P35498>. #filter for interaction
  ?interaction dcterms:references ?pubmed .
} LIMIT 100""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "literature" ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/4431b11d148e0e1bcc3533e90b80225376c80d1a/E.%20Literature/referencesForSpecificInteraction.rq> ;
    dcterms:modified "2026-03-08"^^xsd:date ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
