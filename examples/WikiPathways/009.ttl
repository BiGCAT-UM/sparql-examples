@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:009 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways for a Species"@en ;
    rdfs:comment "Lists all pathways for a given species, returning the WikiPathways identifier and page URL. Default species is Mus musculus. This example uses the default values (Species \"Homo sapiens\"); open it in the WikiPathways SPARQL editor to change them: https://sparql.wikipathways.org/?example=WPQ009"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?wpIdentifier ?pathway ?page
WHERE {
    ?pathway dc:title ?title .
    ?pathway foaf:page ?page .
    ?pathway dc:identifier ?wpIdentifier .
    VALUES ?species { "Homo sapiens" }
    ?pathway wp:organismName ?species .
 }
ORDER BY ?wpIdentifier""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "metadata", "organism", "species" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/c42d381565e5c49c7c754d037d6f253b3214601f/A.%20Metadata/species/PWsforSpecies.rq> ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:contributor <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:created "2020-10-11"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ009> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/A.%20Metadata/species/PWsforSpecies.ttl> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
