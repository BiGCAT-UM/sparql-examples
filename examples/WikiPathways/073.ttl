@prefix cito: <http://purl.org/spar/cito/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:073 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Entry Count per Data Source"@en ;
    rdfs:comment "Counts the data nodes per data source in WikiPathways."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (str(?datasourceLit) as ?datasource)
       (count(DISTINCT ?dataNode) as ?numberEntries)
WHERE {
  ?concept dc:source ?datasourceLit ;
    wp:isAbout ?dataNode .
}
GROUP BY ?datasourceLit
ORDER BY DESC(?numberEntries)""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "data sources", "counts" ;
    cito:usesMethodIn <https://www.wikipathways.org/sparql.html> .
