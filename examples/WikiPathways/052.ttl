@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:052 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolites Without Wikidata Links"@en ;
    rdfs:comment "Lists metabolites that have no Wikidata identifier mapping, useful for identifying gaps in cross-database linkage."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT DISTINCT ?metabolite WHERE {
  ?metabolite a wp:Metabolite .
  OPTIONAL { ?metabolite wp:bdbWikidata ?wikidata . }
  FILTER (!BOUND(?wikidata))
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "curation" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/fa9e83ba0da9ac61f188219e5b7d91ea73f7a5cc/G.%20Curation/MetabolitesWithoutLinkWikidata.rq> ;
    dcterms:creator <https://github.com/laurent2207> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2020-10-09"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ052> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/G.%20Curation/MetabolitesWithoutLinkWikidata.ttl> ;
