@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:065 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways with a Particular Gene"@en ;
    rdfs:comment "Lists all pathways per instance of a particular gene or protein (wp:GeneProduct), here all gene products whose label contains \"CYP\"."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway (str(?label) as ?geneProduct)
WHERE {
    ?gene a wp:GeneProduct .
    ?gene rdfs:label ?label .
    ?gene dcterms:isPartOf ?pathway .
    ?pathway a wp:Pathway .

    FILTER regex(str(?label), "CYP").
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "gene", "pathway", "general" ;
    prov:wasDerivedFrom <https://www.wikipathways.org/sparql.html> ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ065> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/D.%20General/PathwaysWithGene.ttl> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
