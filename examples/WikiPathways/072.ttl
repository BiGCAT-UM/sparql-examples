@prefix cito: <http://purl.org/spar/cito/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:072 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "All Data Sources"@en ;
    rdfs:comment "Lists all data sources currently used for identifiers in WikiPathways."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT DISTINCT (str(?datasourceLit) as ?datasource)
WHERE {
  ?concept dc:source ?datasourceLit
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "data sources" ;
    cito:usesMethodIn <https://www.wikipathways.org/sparql.html> .
