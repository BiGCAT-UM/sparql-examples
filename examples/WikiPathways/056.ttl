@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:056 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "SMILES for Metabolites"@en ;
    rdfs:comment "Retrieves SMILES chemical structure notations for metabolites via their Wikidata links."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX cheminf: <http://semanticscience.org/resource/>

SELECT ?mol ?smilesDepict WHERE {
 ?mol wp:bdbWikidata/cheminf:CHEMINF_000018 ?smilesDepict .
} LIMIT 25""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "chemistry" ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/master/H.%20Chemistry/smiles.rq> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
