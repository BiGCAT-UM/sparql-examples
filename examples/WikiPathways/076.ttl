@prefix cito: <http://purl.org/spar/cito/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:076 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "All Metabolites"@en ;
    rdfs:comment "Lists all metabolite data nodes with their labels."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?mb ?label WHERE {
  ?mb a wp:Metabolite ;
     rdfs:label ?label .
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "metabolite" ;
    cito:usesMethodIn <https://www.wikipathways.org/metabolome.html> .
