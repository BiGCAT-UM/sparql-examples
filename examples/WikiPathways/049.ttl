@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:049 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Count of Pathways Without References"@en ;
    rdfs:comment "Returns the total number of pathways that have no associated publication references."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (count(DISTINCT ?pathway) AS ?pathwayCount) WHERE {
  ?pathway a wp:Pathway ; dc:title ?titleLit ; wp:organismName ?speciesLabelLit .
  MINUS { ?pubmed a       wp:PublicationReference .
          ?pubmed dcterms:isPartOf ?pathway }
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "curation" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/G.%20Curation/countPWsWithoutRef.rq> ;
    dcterms:creator <https://github.com/laurent2207> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2020-10-09"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ049> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/G.%20Curation/countPWsWithoutRef.ttl> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
