@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:020 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Inborn Errors of Metabolism Metabolic Pathways"@en ;
    rdfs:comment "Retrieves pathways classified under metabolic pathway ontology terms, filtering by label to find metabolic pathway annotations."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT distinct ?pathway ?label ?tag
WHERE {
  ?tag1 a owl:Class ;
  rdfs:label ?label .
  ?tag rdfs:subClassOf* ?tag1.
  ?pathway a wp:Pathway; wp:ontologyTag ?tag.
FILTER regex(str(?label), "metabolic pathway")
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "communities", "inborn errors of metabolism", "metabolism" ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/master/B.%20Communities/Inborn%20Errors%20of%20Metabolism/allMetabolicPWs.rq> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
