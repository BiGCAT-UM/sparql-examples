@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:013 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Count of Entity Type"@en ;
    rdfs:comment "Counts the total number of a selected entity type in WikiPathways. This example uses the default value (Entity Type \"DataNode\"); the WikiPathways SNORQL UI lets you change it."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT (COUNT(?entity) AS ?count)
WHERE {
    ?entity a wp:DataNode .
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "metadata", "counts" ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/master/A.%20Metadata/datacounts/countOfEntityType.rq> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .
