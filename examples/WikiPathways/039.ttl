@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:039 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Ontology Terms of a Pathway"@en ;
    rdfs:comment "Retrieves all ontology tags associated with a given pathway, returning the ontology term URI, pathway title, and identifier. This example uses the default values (Pathway ID \"WP1560\"); open it in the WikiPathways SPARQL editor to change them: https://sparql.wikipathways.org/?example=WPQ039"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (?o as ?pwOntologyTerm) (str(?titleLit) as ?title) ?pathway
WHERE {
  VALUES ?pathwayId { "WP1560" }
  ?pathwayRDF wp:ontologyTag ?o ;
    dc:identifier ?pathway ;
    dc:title ?titleLit ;
    dcterms:identifier ?pathwayId .

  FILTER (! regex(str(?pathway), "group"))
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "general" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/1366822debc316b6cdaf88354b020008d0d3cb71/D.%20General/OntologyofPathway.rq> ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:contributor <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:created "2020-10-11"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ039> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/D.%20General/OntologyofPathway.ttl> ;
