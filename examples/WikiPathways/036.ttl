@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://bigcat-um.github.io/sparql-examples/WikiPathways/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:036 a sh:SPARQLExecutable,
       sh:SPARQLSelectExecutable ;
    rdfs:label "Genes of a Pathway"@en ;
    rdfs:comment "Lists all gene products in a given pathway, returning the pathway identifier and gene product labels. This example uses the default values (Pathway ID \"WP1560\"); open it in the WikiPathways SPARQL editor to change them: https://sparql.wikipathways.org/?example=WPQ036"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

select distinct ?pathway (str(?label) as ?geneProduct) where {
    {
        SELECT ?pathwayRev ?pathway WHERE {
            VALUES ?pathwayId { "WP1560" }
            ?pathwayRev dcterms:identifier ?pathwayId .
            ?pathwayRev a wp:Pathway .
            ?pathwayRev dc:identifier ?pathway .
        }
    }
    ?gene dcterms:isPartOf ?pathwayRev .
    ?gene a wp:GeneProduct .
    ?gene rdfs:label ?label .
}""" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:keywords "general" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/D.%20General/GenesofPathway.rq> ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:contributor <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:created "2020-10-11"^^xsd:date ;
    dcterms:modified "2026-11-11"^^xsd:date ;
    schema:version "1.0.0" ;
    owl:sameAs <https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ036> ;
    dcterms:source <https://github.com/wikipathways/SPARQLQueries/blob/fed6a2dc597c5bd82160de17a46cbe36185f21a6/D.%20General/GenesofPathway.ttl> ;
